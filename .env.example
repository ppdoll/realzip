# ─────────────────────────────────────────────────────────────
# 필수: 공공데이터포털(data.go.kr) 일반 인증키 "Decoding" 값
#   → 마이페이지 > 개발계정 > 일반 인증키(Decoding)
#
#   키는 하나지만 **API 마다 따로 활용신청**해야 한다 (둘 다 즉시 자동승인):
#     매매   https://www.data.go.kr/data/15126468/openapi.do
#     전월세 https://www.data.go.kr/data/15126474/openapi.do
#   전월세를 신청하지 않으면 매매만 동작하고, 전월세 카드에 안내가 표시된다.
# ─────────────────────────────────────────────────────────────
MOLIT_SERVICE_KEY=

# ─────────────────────────────────────────────────────────────
# 선택: Supabase (없으면 메모리 캐시 모드로 동작 — 조회는 되지만 느리고 휘발성)
#
#   1) https://supabase.com 에서 프로젝트 생성 (무료 티어 500MB)
#   2) Project Settings > API Keys
#        SUPABASE_URL              ← Project URL
#        SUPABASE_SERVICE_ROLE_KEY ← service_role (secret) 키
#      service_role 은 RLS 를 우회하므로 서버 전용이다.
#      NEXT_PUBLIC_ 접두어를 붙이면 브라우저로 노출되니 절대 붙이지 말 것.
#   3) 테이블 생성: npm run db:setup  (또는 src/lib/schema.sql 을 SQL Editor 에 붙여넣기)
#   4) 확인:       npm run db:check
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 선택: npm run db:setup 으로 테이블을 자동 생성할 때만 필요.
#   Supabase 대시보드 > Connect > Session pooler 의 연결 문자열
#   (형태: postgresql://postgres.<ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres)
#   스키마를 SQL Editor 에 직접 붙여넣을 거면 비워둬도 된다.
SUPABASE_DB_URL=

# 선택: /api/cron/* 보호용 토큰 (Vercel Cron은 Authorization 헤더로 CRON_SECRET 전송)
CRON_SECRET=
